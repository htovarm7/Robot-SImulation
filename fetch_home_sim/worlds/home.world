<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="home">
    <physics name="default" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Soft fill light so the home is not gloomy -->
    <light name="ceiling_light" type="point">
      <pose>0 0 2.6 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>30</range>
        <linear>0.05</linear>
        <constant>0.5</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!--
      House: 14m x 14m. North half (y>0) is the kitchen, south half (y<0)
      is the living room. The two rooms share a 1.5m doorway centered at
      the origin (so the partition wall is split into x∈[-7,-0.75] and
      x∈[0.75, 7]).
    -->
    <model name="home_walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="walls">
        <!-- north wall -->
        <collision name="n_col"><pose>0 7 1.25 0 0 0</pose><geometry><box><size>14 0.1 2.5</size></box></geometry></collision>
        <visual name="n_vis"><pose>0 7 1.25 0 0 0</pose><geometry><box><size>14 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.84 1</ambient><diffuse>0.92 0.90 0.84 1</diffuse></material></visual>
        <!-- south wall -->
        <collision name="s_col"><pose>0 -7 1.25 0 0 0</pose><geometry><box><size>14 0.1 2.5</size></box></geometry></collision>
        <visual name="s_vis"><pose>0 -7 1.25 0 0 0</pose><geometry><box><size>14 0.1 2.5</size></box></geometry><material><ambient>0.92 0.90 0.84 1</ambient><diffuse>0.92 0.90 0.84 1</diffuse></material></visual>
        <!-- west wall -->
        <collision name="w_col"><pose>-7 0 1.25 0 0 0</pose><geometry><box><size>0.1 14 2.5</size></box></geometry></collision>
        <visual name="w_vis"><pose>-7 0 1.25 0 0 0</pose><geometry><box><size>0.1 14 2.5</size></box></geometry><material><ambient>0.92 0.90 0.84 1</ambient><diffuse>0.92 0.90 0.84 1</diffuse></material></visual>
        <!-- east wall -->
        <collision name="e_col"><pose>7 0 1.25 0 0 0</pose><geometry><box><size>0.1 14 2.5</size></box></geometry></collision>
        <visual name="e_vis"><pose>7 0 1.25 0 0 0</pose><geometry><box><size>0.1 14 2.5</size></box></geometry><material><ambient>0.92 0.90 0.84 1</ambient><diffuse>0.92 0.90 0.84 1</diffuse></material></visual>

        <!-- partition between kitchen (y>0) and living room (y<0).
             Doorway is 2.0m wide (±1.0 m from centre) so the inflated
             robot footprint (0.30 + 0.35 = 0.65 m) fits with margin. -->
        <collision name="p_w_col"><pose>-4.0 0 1.25 0 0 0</pose><geometry><box><size>6.0 0.1 2.5</size></box></geometry></collision>
        <visual name="p_w_vis"><pose>-4.0 0 1.25 0 0 0</pose><geometry><box><size>6.0 0.1 2.5</size></box></geometry><material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material></visual>
        <collision name="p_e_col"><pose>4.0 0 1.25 0 0 0</pose><geometry><box><size>6.0 0.1 2.5</size></box></geometry></collision>
        <visual name="p_e_vis"><pose>4.0 0 1.25 0 0 0</pose><geometry><box><size>6.0 0.1 2.5</size></box></geometry><material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Floor texturing per room -->
    <model name="kitchen_floor">
      <static>true</static>
      <pose>0 3.5 0.005 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>13.8 6.9 0.01</size></box></geometry><material><ambient>0.86 0.86 0.90 1</ambient><diffuse>0.86 0.86 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name="living_room_floor">
      <static>true</static>
      <pose>0 -3.5 0.005 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>13.8 6.9 0.01</size></box></geometry><material><ambient>0.55 0.40 0.30 1</ambient><diffuse>0.55 0.40 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Banana on the kitchen island. Placed where the robot can see it. -->
    <model name="banana">
      <static>false</static>
      <pose>0.7 4.0 0.95 0 1.5708 0</pose>
      <link name="link">
        <inertial>
          <mass>0.12</mass>
          <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><cylinder><radius>0.018</radius><length>0.16</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.018</radius><length>0.16</length></cylinder></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
