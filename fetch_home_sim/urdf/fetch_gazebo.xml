<!-- Gazebo Classic plugins layered onto the original Fetch URDF.
     This block is concatenated to fetch.urdf at launch time. -->
<gazebo>
  <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">
    <ros>
      <namespace>/</namespace>
    </ros>
    <update_rate>30</update_rate>
    <left_joint>l_wheel_joint</left_joint>
    <right_joint>r_wheel_joint</right_joint>
    <wheel_separation>0.37476</wheel_separation>
    <wheel_diameter>0.13</wheel_diameter>
    <!-- Plenty of torque to overcome static friction on a 70 kg robot.
         Acceleration kept moderate so the chassis doesn't oscillate on
         its sphere wheels (Segway-style). -->
    <max_wheel_torque>200.0</max_wheel_torque>
    <max_wheel_acceleration>1.0</max_wheel_acceleration>
    <command_topic>cmd_vel</command_topic>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>false</publish_wheel_tf>
    <odometry_topic>odom</odometry_topic>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <odometry_source>1</odometry_source>
  </plugin>

  <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <ros>
      <namespace>/</namespace>
      <remapping>~/out:=joint_states</remapping>
    </ros>
    <update_rate>30</update_rate>
    <!-- All arm/torso/gripper joints are locked fixed in urdf_utils.py
         (free joints without controllers produce NaN under gravity and
         break base_link physics). Only head joints remain commandable. -->
    <joint_name>head_pan_joint</joint_name>
    <joint_name>head_tilt_joint</joint_name>
  </plugin>

  <plugin name="gazebo_ros_joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
    <ros>
      <namespace>/</namespace>
    </ros>
    <update_rate>50</update_rate>
  </plugin>
</gazebo>

<!-- 2D laser on the laser_link -->
<gazebo reference="laser_link">
  <sensor type="ray" name="base_laser">
    <pose>0 0 0 0 0 0</pose>
    <visualize>false</visualize>
    <update_rate>15</update_rate>
    <ray>
      <scan>
        <horizontal>
          <!-- 360° FOV so the SLAM map covers everything around the robot
               at spawn. Real Fetch only does ~220°, but the back blind spot
               leaves the area behind the robot unmapped, which puts the
               robot's start pose outside the costmap bounds. -->
          <samples>540</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <!-- min must be > robot footprint radius (0.30 m) so the laser
             doesn't paint the robot's own base into the costmap as a
             wall ring around itself. -->
        <min>0.40</min>
        <max>10.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </ray>
    <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>laser_link</frame_name>
    </plugin>
  </sensor>
</gazebo>

<!-- RGBD head camera -->
<gazebo reference="head_camera_rgb_optical_frame">
  <sensor type="depth" name="head_camera">
    <update_rate>15</update_rate>
    <camera>
      <horizontal_fov>1.0472</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>10.0</far>
      </clip>
    </camera>
    <plugin name="head_camera_controller" filename="libgazebo_ros_camera.so">
      <ros>
        <namespace>head_camera</namespace>
      </ros>
      <camera_name>head_camera</camera_name>
      <frame_name>head_camera_rgb_optical_frame</frame_name>
      <hack_baseline>0.07</hack_baseline>
      <min_depth>0.1</min_depth>
    </plugin>
  </sensor>
</gazebo>

<!-- Friction & material tweaks -->
<gazebo reference="r_wheel_link">
  <mu1>2.0</mu1><mu2>2.0</mu2>
  <kp>1e8</kp><kd>50.0</kd>
  <fdir1>1 0 0</fdir1>
  <minDepth>0.001</minDepth>
  <maxVel>0.1</maxVel>
</gazebo>
<gazebo reference="l_wheel_link">
  <mu1>2.0</mu1><mu2>2.0</mu2>
  <kp>1e8</kp><kd>50.0</kd>
  <fdir1>1 0 0</fdir1>
  <minDepth>0.001</minDepth>
  <maxVel>0.1</maxVel>
</gazebo>
<gazebo reference="base_link">
  <material>Gazebo/Grey</material>
</gazebo>
